{
	"i18n": true,
	"type": "tabs",
	"items": {
		"_broker": {
			"type": "panel",
			"label": "MQTT broker",
			"items": {
				"brokerMode": {
					"type": "select",
					"label": "Broker",
					"newLine": true,
					"options": [
						{
							"label": "brokerModeInternal",
							"value": "internal"
						},
						{
							"label": "brokerModeExternal",
							"value": "external"
						}
					],
					"xs": 12,
					"sm": 12,
					"md": 8,
					"lg": 6,
					"xl": 6
				},
				"_hintInternal": {
					"type": "staticText",
					"text": "brokerHintInternal",
					"hidden": "data.brokerMode !== 'internal'",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"_hint": {
					"type": "staticText",
					"text": "brokerHintExternal",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"hidden": "data.brokerMode === 'internal'"
				},
				"port": {
					"type": "number",
					"label": "Port",
					"min": 1,
					"max": 65535,
					"hidden": "data.brokerMode !== 'internal'",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 2,
					"xl": 2
				},
				"bind": {
					"type": "text",
					"label": "Listen on",
					"help": "bindHelp",
					"hidden": "data.brokerMode !== 'internal'",
					"xs": 12,
					"sm": 12,
					"md": 8,
					"lg": 4,
					"xl": 4
				},
				"host": {
					"type": "text",
					"label": "Host",
					"help": "hostHelp",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 8,
					"lg": 6,
					"xl": 6,
					"hidden": "data.brokerMode === 'internal'"
				},
				"hostPort": {
					"type": "number",
					"label": "Port",
					"min": 1,
					"max": 65535,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 2,
					"xl": 2,
					"hidden": "data.brokerMode === 'internal'"
				},
				"username": {
					"type": "text",
					"label": "User name",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4,
					"help": "loginHelp"
				},
				"password": {
					"type": "password",
					"label": "Password",
					"repeat": false,
					"visible": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"tls": {
					"type": "checkbox",
					"label": "Use TLS (mqtts)",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4,
					"hidden": "data.brokerMode === 'internal'"
				},
				"rejectUnauthorized": {
					"type": "checkbox",
					"label": "Verify the broker certificate",
					"hidden": "data.brokerMode === 'internal' || !data.tls",
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"clientId": {
					"type": "text",
					"label": "Client ID",
					"help": "clientIdHelp",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4,
					"hidden": "data.brokerMode === 'internal'"
				}
			}
		},
		"_agents": {
			"type": "panel",
			"label": "Agents",
			"items": {
				"topicBase": {
					"type": "text",
					"label": "Topic base",
					"help": "topicBaseHelp",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"cmdTimeout": {
					"type": "number",
					"label": "Command timeout (s)",
					"min": 1,
					"max": 600,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"askTimeout": {
					"type": "number",
					"label": "Timeout for dialogs (ask) (s)",
					"help": "askTimeoutHelp",
					"min": 5,
					"max": 3600,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				}
			}
		}
	}
}
